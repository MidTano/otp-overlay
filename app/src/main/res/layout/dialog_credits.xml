<?xml version="1.0" encoding="utf-8"?>
<!--
    Credits dialog content view.

    Triggered by the easter-egg tap on the "Emoji animations from
    KawaiiEmoji" footer below the main screen's build info.

    Visual language matches @layout/dialog_about exactly so the two
    feel like the same family of small lightboxes:
      • centred 96-dp Lottie header tinted white in CreditsDialog.kt
      • centred subtitle line below it
      • a multi-line attribution paragraph
      • two tappable rows (Telegram pack + GitHub issues)
      • a flat "Close" CTA

    Every tappable row reuses @drawable/about_link_row_bg so the
    pressed state is consistent with @layout/dialog_about and the
    rest of the settings screen.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="18dp">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_credits_header"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            app:lottie_rawRes="@raw/lottie_emoji_credits"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_speed="1.0"
            android:contentDescription="@null"/>

        <!-- Centred subtitle (no separate title — the Lottie carries
             the visual identity). -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/credits_dialog_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/jetbrains_mono"
            android:layout_marginBottom="14dp"/>

        <!-- Attribution paragraph. Multi-line, prose-style. Uses
             text_tertiary so it reads as an explanation rather than
             a CTA. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/credits_dialog_body"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.35"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:id="@+id/credits_row_pack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/about_link_row_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/credits_link_pack_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/credits_link_pack_subtitle"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                tools:ignore="SmallSp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/credits_row_contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/about_link_row_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/credits_link_contact_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/credits_link_contact_subtitle"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                tools:ignore="SmallSp"/>
        </LinearLayout>

        <Button
            android:id="@+id/credits_btn_close"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/about_close"
            android:textColor="@color/text_settings_btn"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:background="@drawable/btn_secondary"
            android:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>
</ScrollView>
