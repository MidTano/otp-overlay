<?xml version="1.0" encoding="utf-8"?>
<!--
    Main launcher screen.

    Two layers stacked inside a FrameLayout:

    1. content_root  — the actual ScrollView with the status panel,
                        OTP preview tester, and the Settings/Stats CTA.
                        Visible from the start so the suck-in reveal
                        lands on the real UI underneath.

    2. main_splash_root — a Lottie greeting overlay played on every
                        cold launch (see MainActivity.setupSplashAnim).
                        Mirrors the onboarding overlay (same suck-in
                        + Lottie collapse), but uses lottie_splash and
                        the 12 splash messages instead of a permission
                        Lottie. Skipped via EXTRA_SKIP_SPLASH_ANIM
                        when MainActivity is started directly after
                        the crash dialog or after onboarding so the
                        user never sees two greeting animations
                        back-to-back.
-->

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <!-- ▼ Real main-screen content ─────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="32dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_wordmark"
                android:textSize="26sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_subtitle"
                android:textSize="11sp"
                android:textColor="@color/text_quaternary"
                android:letterSpacing="0.3"
                android:layout_marginBottom="28dp"/>

            <!-- ── Status ──────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_section_status"
                android:textColor="@color/text_quaternary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.3"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/card_bg"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <ImageView
                        android:id="@+id/iv_status_overlay"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_warning_circle"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/main_status_overlay"
                        android:textColor="@color/text_chip_strong"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tv_status_overlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <ImageView
                        android:id="@+id/iv_status_sms"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_warning_circle"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/main_status_sms"
                        android:textColor="@color/text_chip_strong"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tv_status_sms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/iv_status_push"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_warning_circle"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/main_status_push"
                        android:textColor="@color/text_chip_strong"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tv_status_push"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Hidden text sink for diagnostic strings produced by
                 MainActivity.updateStatus(). The user-facing status
                 lives in the icon/label rows above; this sink also
                 serves as the presence flag updateStatus() probes
                 before rendering. -->
            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btn_open_onboarding"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="@string/btn_permissions"
                android:background="@drawable/btn_secondary"
                android:backgroundTint="@null"
                android:textColor="@color/text_settings_btn"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginBottom="24dp"/>

            <!-- ── Overlay test ────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_section_preview"
                android:textColor="@color/text_quaternary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.3"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/et_test_code"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="@string/main_hint_code"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_input_hint_dim"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:inputType="number"
                android:maxLength="9"
                android:background="@drawable/input_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:autofillHints="off"/>

            <EditText
                android:id="@+id/et_test_sender"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/main_hint_sender"
                android:textColor="@color/text_chip_strong"
                android:textColorHint="@color/text_input_hint_dim"
                android:textSize="13sp"
                android:background="@drawable/input_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="12dp"
                android:autofillHints="off"
                android:inputType="text"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_samples_label"
                    android:textColor="@color/text_quaternary"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp"/>

                <TextView android:id="@+id/sample_4" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/main_sample_4"
                    android:textColor="@color/onboarding_chip_dim" android:textSize="12sp"
                    android:background="@drawable/tag_bg" android:paddingStart="10dp"
                    android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                    android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"/>

                <TextView android:id="@+id/sample_6" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/main_sample_6"
                    android:textColor="@color/onboarding_chip_dim" android:textSize="12sp"
                    android:background="@drawable/tag_bg" android:paddingStart="10dp"
                    android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                    android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"/>

                <TextView android:id="@+id/sample_8" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/main_sample_8"
                    android:textColor="@color/onboarding_chip_dim" android:textSize="12sp"
                    android:background="@drawable/tag_bg" android:paddingStart="10dp"
                    android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                    android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"/>

                <TextView android:id="@+id/sample_9" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/main_sample_9"
                    android:textColor="@color/onboarding_chip_dim" android:textSize="12sp"
                    android:background="@drawable/tag_bg" android:paddingStart="10dp"
                    android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                    android:clickable="true" android:focusable="true"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                tools:ignore="ButtonStyle">

                <Button
                    android:id="@+id/btn_settings"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:drawablePadding="8dp"
                    android:background="@drawable/btn_secondary"
                    android:backgroundTint="@null"
                    android:textColor="@color/text_settings_btn"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginEnd="5dp"/>

                <Button
                    android:id="@+id/btn_stats"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_stats"
                    android:drawableStart="@drawable/ic_chart"
                    android:drawablePadding="8dp"
                    android:background="@drawable/btn_secondary"
                    android:backgroundTint="@null"
                    android:textColor="@color/text_settings_btn"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btn_preview"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_preview"
                android:background="@drawable/btn_secondary"
                android:backgroundTint="@null"
                android:textColor="@color/text_button_bright"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <TextView
                android:id="@+id/tv_build_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_build_chip"
                android:textSize="11sp"
                android:fontFamily="@font/jetbrains_mono"
                android:layout_marginTop="20dp"
                android:gravity="center"
                tools:ignore="SmallSp"/>

            <!-- Tiny third-party-credit footer.

                 Tap target for [CreditsDialog]. Kept deliberately
                 unobtrusive — a faint pill outline + ripple gives
                 just enough visual affordance to read as
                 interactive, while the rest of the technical
                 footer above stays as plain text. The trailing
                 "↗" glyph hints that the chip leads to an
                 external destination (the dialog's link rows then
                 open the actual URL in the browser). -->
            <LinearLayout
                android:id="@+id/tv_credits_footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/credits_footer_chip_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_credits_footer_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:gravity="center"
                    tools:ignore="SmallSp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_credits_footer_arrow"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"
                    tools:ignore="SmallSp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ▼ Splash overlay — sits above the main content ─────────────── -->
    <!--
        main_splash_root — the cold-launch greeting layer. Mirrors the
        onboarding overlay (same SuckInOverlayView + Lottie collapse
        choreography). Uses lottie_splash plus a randomly picked
        greeting message from the @string/splash_msg_* set.

        Hidden directly in MainActivity.onCreate when the activity is
        launched with EXTRA_SKIP_SPLASH_ANIM — i.e. coming back from
        the crash dialog or finishing onboarding — so the user never
        sees two greeting animations stacked.
    -->
    <FrameLayout
        android:id="@+id/main_splash_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.midtano.otp.overlay.SuckInOverlayView
            android:id="@+id/main_suck_in_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/main_lottie_splash"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.60"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_bias="0.36"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"/>

            <TextView
                android:id="@+id/tv_main_splash_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/jetbrains_mono_bold"
                android:alpha="0"
                android:visibility="invisible"
                app:layout_constraintTop_toBottomOf="@id/main_lottie_splash"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</FrameLayout>
