<?xml version="1.0" encoding="utf-8"?>
<!-- Auto-paste confirmation toast. -->
<com.midtano.otp.overlay.BackInterceptLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:ignore="UnusedAttribute">

    <com.midtano.otp.overlay.OtpRevealLayout
        android:id="@+id/reveal_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="22dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:id="@+id/card_root"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/overlay_bg"
            android:elevation="16dp"
            android:clipToOutline="true"
            android:minHeight="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/iv_app_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null"/>

            <TextView
                android:id="@+id/tv_autopaste_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_autopaste_label"
                android:textColor="@color/text_chip"
                android:textSize="12sp"
                android:maxLines="1"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/tv_autopaste_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:fontFamily="@font/jetbrains_mono"
                android:letterSpacing="0.06"
                android:maxLines="1"/>

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_autopaste"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"/>

        </LinearLayout>

    </com.midtano.otp.overlay.OtpRevealLayout>

</com.midtano.otp.overlay.BackInterceptLayout>
