<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="30dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/chip_bg"
    android:paddingStart="12dp"
    android:paddingEnd="6dp">

    <!-- Trigger-word chip used in Settings. -->

    <TextView
        android:id="@+id/tv_chip_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_chip_strong"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <View
        android:layout_width="4dp"
        android:layout_height="1dp"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_chip_delete"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/close_btn_bg"
        android:src="@drawable/ic_close"
        android:padding="5dp"
        app:tint="#9A9A9A"
        android:contentDescription="@string/cd_trigger_delete"/>

</LinearLayout>
