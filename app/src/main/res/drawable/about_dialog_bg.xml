<?xml version="1.0" encoding="utf-8"?>
<!--
    About dialog window background. Matches the visual language of
    @drawable/card_bg and @drawable/onboard_card_bg (dark surface +
    1-dp neutral border + soft 16-dp corner radius), so the dialog
    feels like one more "card" in the same design system rather than
    a system AlertDialog skin.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0F0F0F"/>
    <corners android:radius="16dp"/>
    <stroke android:width="1dp" android:color="#262626"/>
</shape>
