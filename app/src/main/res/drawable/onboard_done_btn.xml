<?xml version="1.0" encoding="utf-8"?>
<!-- Primary "Done" CTA on the onboarding screen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <solid android:color="#0E0E0E"/>
            <stroke android:width="1dp" android:color="#1F1F1F"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <solid android:color="#262626"/>
            <stroke android:width="1dp" android:color="#3A3A3A"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <solid android:color="#1A1A1A"/>
            <stroke android:width="1dp" android:color="#2E2E2E"/>
        </shape>
    </item>
</selector>
